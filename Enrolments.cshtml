@model EventEnrolmentsViewModel
@{
    ViewData["Title"] = "Enrolments";
    var confirmed = Model.Enrolments.Count(e => e.Status == "Enrolled");
    var cancelled = Model.Enrolments.Count(e => e.Status == "Cancelled");
}

<a asp-action="Events">&larr; Back to my events</a>
<h2 class="rd-page-title mt-2">Enrolments: @Model.Event.EventName</h2>
<p class="text-muted">
    @Model.Event.EventDate.ToString("dddd, d MMMM yyyy") &middot;
    <strong>@confirmed</strong> confirmed, <strong>@cancelled</strong> cancelled
</p>

@if (!Model.Enrolments.Any())
{
    <div class="rd-card p-4 text-center">Nobody has enrolled for this event yet.</div>
}
else
{
    <div class="rd-card p-3">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Bib</th>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Distance</th>
                        <th>Enrolled on</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Enrolments)
                    {
                        <tr>
                            <td>@item.BibNumber</td>
                            <td><strong>@item.ParticipantName</strong></td>
                            <td>@item.CategoryName</td>
                            <td>@item.DistanceKM.ToString("0.##") km</td>
                            <td>@item.EnrolmentDate.ToString("d MMM yyyy HH:mm")</td>
                            <td><partial name="_StatusBadge" model="item.Status" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
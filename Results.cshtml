@model ResultsViewModel
@{
    ViewData["Title"] = "Results";
    var locked = !Model.EventHasEnded;
}

<a asp-action="Events">&larr; Back to my events</a>
<h2 class="rd-page-title mt-2">Results: @Model.Event.EventName</h2>
<p class="text-muted">
    @Model.Event.EventDate.ToString("dddd, d MMMM yyyy") &middot;
    Results are published to participants as soon as you save them.
</p>

@if (locked)
{
    <div class="alert alert-info">
        This event hasn't taken place yet. You can enter results once the event has concluded.
    </div>
}

<div class="form-text mb-3">
    <strong>Finished</strong> needs a finish time. <strong>DNF</strong> (did not finish) has no finish time, but you can
    record the distance covered. <strong>DNS</strong> (did not start) has neither. Only finished results have a position.
</div>

@if (!Model.Rows.Any())
{
    <div class="rd-card p-4 text-center">There are no confirmed enrolments to capture results for.</div>
}
else
{
    <fieldset disabled="@locked">
        @foreach (var row in Model.Rows)
        {
            var result = row.Result;
            <form asp-action="SaveResult" method="post" class="rd-card p-3 mb-2">
                <input type="hidden" name="EventId" value="@Model.Event.EventID" />
                <input type="hidden" name="EnrolmentId" value="@row.Enrolment.EnrolmentID" />
                <input type="hidden" name="ResultId" value="@(result?.ResultID ?? 0)" />

                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <strong>@row.Enrolment.ParticipantName</strong>
                        <div class="small text-muted">Bib @row.Enrolment.BibNumber &middot; @row.Enrolment.CategoryName</div>
                        @if (result != null)
                        {
                            <partial name="_StatusBadge" model="result.Status" />
                        }
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Status</label>
                        <select name="Status" class="form-select form-select-sm">
                            @foreach (var s in new[] { "Finished", "DNF", "DNS" })
                            {
                                <option value="@s" selected="@(result?.Status == s)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Finish time</label>
                        <input type="time" step="1" name="FinishTime" class="form-control form-control-sm"
                               value="@(result?.FinishTime?.ToString("HH:mm:ss"))" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Position</label>
                        <input type="number" min="1" name="Position" class="form-control form-control-sm"
                               value="@result?.Position" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small mb-1">Distance covered (km)</label>
                        <input type="number" step="0.01" min="0" name="DistanceCoveredKM" class="form-control form-control-sm"
                               value="@result?.DistanceCoveredKM" />
                    </div>
                    <div class="col-md-1 d-grid">
                        <button type="submit" class="btn btn-rd btn-sm">@(result == null ? "Save" : "Update")</button>
                    </div>
                </div>
            </form>
        }
    </fieldset>
}
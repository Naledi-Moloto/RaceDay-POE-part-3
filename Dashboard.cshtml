@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var next = Model.UpcomingEvents.FirstOrDefault();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="rd-page-title mb-0">Organiser dashboard</h2>
    <a class="btn btn-rd" asp-action="CreateEvent">+ Create event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-number">@Model.TotalEvents</div>
            <div class="rd-stat-label">Total events</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-number">@Model.UpcomingEvents.Count</div>
            <div class="rd-stat-label">Upcoming events</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-number">@Model.TotalEnrolments</div>
            <div class="rd-stat-label">Total enrolments</div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-number">@(next == null ? "None" : next.EventDate.ToString("d MMM"))</div>
            <div class="rd-stat-label">Next event</div>
        </div>
    </div>
</div>

<h4 class="mb-3">Upcoming events</h4>
@if (!Model.UpcomingEvents.Any())
{
    <div class="rd-card p-4 text-center mb-4">
        <p class="mb-3">You have no upcoming events.</p>
        <a class="btn btn-rd" asp-action="CreateEvent">Create your first event</a>
    </div>
}
else
{
    <div class="rd-card p-3 mb-4">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Event</th>
                        <th>Location</th>
                        <th>Enrolments</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.UpcomingEvents)
                    {
                        <tr>
                            <td>@ev.EventDate.ToString("ddd, d MMM yyyy")<br /><small class="text-muted">@ev.StartTime.ToString("HH:mm")</small></td>
                            <td><strong>@ev.EventName</strong></td>
                            <td>@ev.VenueName, @ev.City</td>
                            <td><span class="rd-badge rd-badge-neutral">@ev.EnrolmentCount</span></td>
                            <td class="text-end">
                                <a class="btn btn-rd-outline btn-sm" asp-action="Enrolments" asp-route-id="@ev.EventID">View enrolments</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<h4 class="mb-3">Past events</h4>
@if (!Model.PastEvents.Any())
{
    <div class="rd-card p-4 text-center">No past events yet.</div>
}
else
{
    <div class="rd-card p-3">
        <div class="table-responsive">
            <table class="table rd-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Event</th>
                        <th>Enrolments</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ev in Model.PastEvents)
                    {
                        <tr>
                            <td>@ev.EventDate.ToString("d MMM yyyy")</td>
                            <td><strong>@ev.EventName</strong></td>
                            <td><span class="rd-badge rd-badge-neutral">@ev.EnrolmentCount</span></td>
                            <td class="text-end">
                                <a class="btn btn-rd-outline btn-sm" asp-action="Results" asp-route-id="@ev.EventID">Enter results</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}